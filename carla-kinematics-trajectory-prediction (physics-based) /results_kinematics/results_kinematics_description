[EXPERIMENTAL_SETUP]
Simulator = CARLA
Prediction_Method = Kinematic Equations
Prediction_Horizon = 3.0 s
Sampling_Interval = 0.05 s
Evaluation_Metrics = Average Displacement Error (ADE), Miss Rate (MR)
Scenarios = 3 (Left Turn, Right Turn, Straight Line)

